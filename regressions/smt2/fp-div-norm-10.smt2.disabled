; Regression for issue #10175 / PR #10216 (fp.div normalization fix).
; FP(3,8): boundary case where 2^ebits = sbits (2^3 = 8), old code path.
; 1.0 / 1.0 = 1.0.
(set-logic QF_FP)
(set-info :status sat)
(define-fun one () (_ FloatingPoint 3 8) ((_ to_fp 3 8) RNE 1.0))
(assert (fp.eq one (fp.div RNE one one)))
(check-sat)
