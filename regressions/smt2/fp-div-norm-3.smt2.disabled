; Regression for issue #10175 / PR #10216 (fp.div normalization fix).
; FP(2,6): exact division in the representable range (no rounding needed).
; 2.0 / 1.0 = 2.0.
(set-logic QF_FP)
(set-info :status sat)
(define-fun two () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RNE 2.0))
(define-fun one () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RNE 1.0))
(assert (fp.eq two (fp.div RNE two one)))
(check-sat)
