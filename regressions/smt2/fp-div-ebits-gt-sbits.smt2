; General fp.div coverage for exponent widths greater than significand widths.
(set-logic ALL)
(set-option :model_validate true)

(define-sort FP43 () (_ FloatingPoint 4 3))
(define-fun bad-div-43 ((rm RoundingMode) (x FP43) (y FP43) (want FP43)) Bool
  (not (= (fp.div rm x y) want)))

(define-fun p-one-43 () FP43 (fp #b0 #b0111 #b00))
(define-fun n-one-43 () FP43 (fp #b1 #b0111 #b00))
(define-fun p-two-43 () FP43 (fp #b0 #b1000 #b00))
(define-fun p-three-43 () FP43 (fp #b0 #b1000 #b10))
(define-fun p-min-sub-43 () FP43 (fp #b0 #b0000 #b01))
(define-fun n-min-sub-43 () FP43 (fp #b1 #b0000 #b01))
(define-fun p-max-43 () FP43 (fp #b0 #b1110 #b11))
(define-fun n-max-43 () FP43 (fp #b1 #b1110 #b11))
(define-fun p-seven-eighths-43 () FP43 (fp #b0 #b0110 #b11))
(define-fun p-five-fourths-43 () FP43 (fp #b0 #b0111 #b01))

; Exact values below one, above one, and from normalized denormals.
(push 1)
(assert (bad-div-43 RNE p-one-43 p-two-43 (fp #b0 #b0110 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-one-43 p-two-43 (fp #b0 #b0110 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-one-43 p-two-43 (fp #b0 #b0110 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-one-43 p-two-43 (fp #b0 #b0110 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-one-43 p-two-43 (fp #b0 #b0110 #b00)))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE p-two-43 p-one-43 (fp #b0 #b1000 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-two-43 p-one-43 (fp #b0 #b1000 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-two-43 p-one-43 (fp #b0 #b1000 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-two-43 p-one-43 (fp #b0 #b1000 #b00)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-two-43 p-one-43 (fp #b0 #b1000 #b00)))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE p-min-sub-43 p-min-sub-43 p-one-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-min-sub-43 p-min-sub-43 p-one-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-min-sub-43 p-min-sub-43 p-one-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-min-sub-43 p-min-sub-43 p-one-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-min-sub-43 p-min-sub-43 p-one-43))
(check-sat)
(pop 1)

; Inexact values exercise sign-sensitive directed rounding.
(push 1)
(assert (bad-div-43 RNE p-one-43 p-three-43 (fp #b0 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-one-43 p-three-43 (fp #b0 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-one-43 p-three-43 (fp #b0 #b0101 #b10)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-one-43 p-three-43 (fp #b0 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-one-43 p-three-43 (fp #b0 #b0101 #b01)))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE n-one-43 p-three-43 (fp #b1 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA n-one-43 p-three-43 (fp #b1 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP n-one-43 p-three-43 (fp #b1 #b0101 #b01)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN n-one-43 p-three-43 (fp #b1 #b0101 #b10)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ n-one-43 p-three-43 (fp #b1 #b0101 #b01)))
(check-sat)
(pop 1)

; Half of the minimum subnormal distinguishes ties-to-even from ties-to-away.
(push 1)
(assert (bad-div-43 RNE p-min-sub-43 p-two-43 (_ +zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-min-sub-43 p-two-43 p-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-min-sub-43 p-two-43 p-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-min-sub-43 p-two-43 (_ +zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-min-sub-43 p-two-43 (_ +zero 4 3)))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE n-min-sub-43 p-two-43 (_ -zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA n-min-sub-43 p-two-43 n-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP n-min-sub-43 p-two-43 (_ -zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN n-min-sub-43 p-two-43 n-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ n-min-sub-43 p-two-43 (_ -zero 4 3)))
(check-sat)
(pop 1)

; Exact 256 overflows FP(4,3); directed modes select infinity or max finite.
(push 1)
(assert (bad-div-43 RNE p-max-43 p-seven-eighths-43 (_ +oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-max-43 p-seven-eighths-43 (_ +oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-max-43 p-seven-eighths-43 (_ +oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-max-43 p-seven-eighths-43 p-max-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-max-43 p-seven-eighths-43 p-max-43))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE n-max-43 p-seven-eighths-43 (_ -oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA n-max-43 p-seven-eighths-43 (_ -oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP n-max-43 p-seven-eighths-43 n-max-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN n-max-43 p-seven-eighths-43 (_ -oo 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ n-max-43 p-seven-eighths-43 n-max-43))
(check-sat)
(pop 1)

; Exact 1/320 lies between zero and the minimum subnormal.
(push 1)
(assert (bad-div-43 RNE p-min-sub-43 p-five-fourths-43 p-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA p-min-sub-43 p-five-fourths-43 p-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP p-min-sub-43 p-five-fourths-43 p-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN p-min-sub-43 p-five-fourths-43 (_ +zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ p-min-sub-43 p-five-fourths-43 (_ +zero 4 3)))
(check-sat)
(pop 1)

(push 1)
(assert (bad-div-43 RNE n-min-sub-43 p-five-fourths-43 n-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RNA n-min-sub-43 p-five-fourths-43 n-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTP n-min-sub-43 p-five-fourths-43 (_ -zero 4 3)))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTN n-min-sub-43 p-five-fourths-43 n-min-sub-43))
(check-sat)
(pop 1)
(push 1)
(assert (bad-div-43 RTZ n-min-sub-43 p-five-fourths-43 (_ -zero 4 3)))
(check-sat)
(pop 1)

; Minimum precision, correction-width boundaries, and the first round-width crossing.
(push 1)
(assert (not (= (fp.div RNE (fp #b0 #b01 #b0) (fp #b0 #b01 #b0))
                (fp #b0 #b01 #b0))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE (fp #b0 #b011 #b0) (fp #b0 #b011 #b0))
                (fp #b0 #b011 #b0))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE p-one-43 p-one-43) p-one-43)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE (fp #b0 #b01111 #b00) (fp #b0 #b01111 #b00))
                (fp #b0 #b01111 #b00))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE (fp #b0 #b011111 #b00) (fp #b0 #b011111 #b00))
                (fp #b0 #b011111 #b00))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE
                  (fp #b0 #b0111111111111 #b00)
                  (fp #b0 #b0111111111111 #b00))
                (fp #b0 #b0111111111111 #b00))))
(check-sat)
(pop 1)

; FP(13,3) extreme exponents and the fitting-width FP(12,3) control.
(push 1)
(assert (not (= (fp.div RTZ
                  (fp #b0 #b1111111111110 #b11)
                  (fp #b0 #b0000000000000 #b01))
                (fp #b0 #b1111111111110 #b11))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RTP
                  (fp #b0 #b0000000000000 #b01)
                  (fp #b0 #b1111111111110 #b11))
                (fp #b0 #b0000000000000 #b01))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE
                  (fp #b0 #b011111111111 #b00)
                  (fp #b0 #b011111111111 #b00))
                (fp #b0 #b011111111111 #b00))))
(check-sat)
(pop 1)

; Widest accepted exponent and minimum internal/C-API significand controls.
(push 1)
(assert (not (= (fp.div RNE
                  (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b0)
                  (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b0))
                (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b0))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE
                  (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b00)
                  (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b00))
                (fp #b0 #b011111111111111111111111111111111111111111111111111111111111111 #b00))))
(check-sat)
(pop 1)

; Existing exceptional-result guards remain dominant over eager finite construction.
(push 1)
(assert (not (fp.isNaN (fp.div RNE (_ NaN 4 3) p-one-43))))
(check-sat)
(pop 1)
(push 1)
(assert (not (fp.isNaN (fp.div RNE p-one-43 (_ NaN 4 3)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (fp.isNaN (fp.div RNE (_ +oo 4 3) (_ -oo 4 3)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE p-one-43 (_ +oo 4 3)) (_ +zero 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE p-one-43 (_ -oo 4 3)) (_ -zero 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE p-one-43 (_ +zero 4 3)) (_ +oo 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE p-one-43 (_ -zero 4 3)) (_ -oo 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE (_ +zero 4 3) p-one-43) (_ +zero 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (fp.div RNE (_ -zero 4 3) p-one-43) (_ -zero 4 3))))
(check-sat)
(pop 1)
(push 1)
(assert (not (fp.isNaN (fp.div RNE (_ +zero 4 3) (_ -zero 4 3)))))
(check-sat)
(pop 1)
