; Regression for issue #10175 / PR #10216 (fp.div normalization fix).
; FP(2,6): RTZ overflow clips to the most-negative normal value, not -oo.
; (-3.25) / 0.0625 = -52 overflows; RTZ result = -(2 - 2^-5) * 2^1 = -3.9375.
(set-logic QF_FP)
(set-info :status sat)
(define-fun c () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RTZ (- 3.25)))
(define-fun b () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RTZ 0.0625))
(define-fun expected () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RTZ (- 3.9375)))
(assert (fp.eq expected (fp.div RTZ c b)))
(check-sat)
