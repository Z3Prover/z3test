; Regression for issue #10175 / PR #10216 (fp.div normalization fix).
; FP(2,6): dividing the most-negative-normal by itself gives 1.0.
; -3.9375 / -3.9375 = 1.0.
(set-logic QF_FP)
(set-info :status sat)
(define-fun m () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RTZ (- 3.9375)))
(define-fun one () (_ FloatingPoint 2 6) ((_ to_fp 2 6) RNE 1.0))
(assert (fp.eq one (fp.div RNE m m)))
(check-sat)
